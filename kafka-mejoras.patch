-            new FixedBackOff(1000L, 3L));
+    DefaultErrorHandler kafkaErrorHandler(@Value("${spring.kafka.bootstrap-servers}") String bootstrap) {
+        // byte[] = payloads que no se pudieron deserializar; Object = eventos validos que fallaron al procesarse
+        Map<String, Object> base = Map.of(ProducerConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrap);
+        KafkaTemplate<Object, Object> bytes = new KafkaTemplate<>(
+                new DefaultKafkaProducerFactory<>(base, new ByteArraySerializer(), new ByteArraySerializer()));
+        KafkaTemplate<Object, Object> json = new KafkaTemplate<>(
+                new DefaultKafkaProducerFactory<>(base, new StringSerializer(), new JacksonJsonSerializer<>()));
+        // LinkedHashMap: el orden importa (lo mas especifico primero)
+        Map<Class<?>, KafkaOperations<?, ?>> templates = new LinkedHashMap<>();
+        templates.put(byte[].class, bytes);
+        templates.put(Object.class, json);
+        DeadLetterPublishingRecoverer dlt = new DeadLetterPublishingRecoverer(templates);
+
+        DefaultErrorHandler h = new DefaultErrorHandler((record, ex) -> {
+            log.error("Evento enviado a DLT topic={} particion={} offset={} causa={}",
+                    record.topic(), record.partition(), record.offset(), ex.getMessage());
+            dlt.accept(record, ex);
+        }, new FixedBackOff(1000L, 3L));
         h.addNotRetryableExceptions(IllegalArgumentException.class);
         return h;
     }
