+import org.springframework.kafka.listener.DeadLetterPublishingRecoverer;
 import org.springframework.kafka.listener.DefaultErrorHandler;
+import org.springframework.kafka.support.serializer.JacksonJsonSerializer;
 import org.springframework.util.backoff.FixedBackOff;
 
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Manejo de errores del consumidor Kafka: 3 reintentos (1 s) y, si sigue fallando (o el payload es invalido),
+ * el evento se publica en el topico "<topico>.DLT" y se registra en el log. Asi un mensaje defectuoso
+ * no bloquea la particion ni se pierde.
+ */
 @Configuration
 public class KafkaErrorHandlerConfig {
     private static final Logger log = LoggerFactory.getLogger(KafkaErrorHandlerConfig.class);
 
+    /** Topico de mensajes muertos: mismas particiones que el original (el recoverer conserva la particion). */
+    @Bean
+    NewTopic pedidosVentasDltTopic(@Value("${app.kafka.topics.pedidos-ventas}") String name) {
+        return TopicBuilder.name(name + ".DLT").partitions(3).replicas(3).build();
+    }
+
     @Bean
-    DefaultErrorHandler kafkaErrorHandler() {
