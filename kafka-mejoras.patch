@@ -1,22 +1,61 @@
 package cl.duoc.pedidos360.ms_notificaciones.config;
+
+import org.apache.kafka.clients.admin.NewTopic;
+import org.apache.kafka.clients.producer.ProducerConfig;
+import org.apache.kafka.common.serialization.ByteArraySerializer;
+import org.apache.kafka.common.serialization.StringSerializer;
 import org.slf4j.Logger;
 import org.slf4j.LoggerFactory;
+import org.springframework.beans.factory.annotation.Value;
 import org.springframework.context.annotation.Bean;
 import org.springframework.context.annotation.Configuration;
+import org.springframework.kafka.config.TopicBuilder;
+import org.springframework.kafka.core.DefaultKafkaProducerFactory;
+import org.springframework.kafka.core.KafkaOperations;
+import org.springframework.kafka.core.KafkaTemplate;
+import org.springframework.kafka.listener.DeadLetterPublishingRecoverer;
 import org.springframework.kafka.listener.DefaultErrorHandler;
+import org.springframework.kafka.support.serializer.JacksonJsonSerializer;
 import org.springframework.util.backoff.FixedBackOff;
 
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Manejo de errores del consumidor Kafka: 3 reintentos (1 s) y, si sigue fallando (o el payload es invalido),
+ * el evento se publica en el topico "<topico>.DLT" y se registra en el log. Asi un mensaje defectuoso
+ * no bloquea la particion ni se pierde.
+ */
 @Configuration
 public class KafkaErrorHandlerConfig {
     private static final Logger log = LoggerFactory.getLogger(KafkaErrorHandlerConfig.class);
 
+    /** Topico de mensajes muertos: mismas particiones que el original (el recoverer conserva la particion). */
+    @Bean
+    NewTopic clientesRegistroDltTopic(@Value("${app.kafka.topics.clientes-registro}") String name) {
+        return TopicBuilder.name(name + ".DLT").partitions(3).replicas(3).build();
+    }
+
     @Bean
-    DefaultErrorHandler kafkaErrorHandler() {
-        DefaultErrorHandler h = new DefaultErrorHandler(
-            (record, ex) -> log.error("Evento descartado tras reintentos topic={} particion={} offset={} causa={}",
-                    record.topic(), record.partition(), record.offset(), ex.getMessage()),
-            new FixedBackOff(1000L, 3L));
+    DefaultErrorHandler kafkaErrorHandler(@Value("${spring.kafka.bootstrap-servers}") String bootstrap) {
+        // byte[] = payloads que no se pudieron deserializar; Object = eventos validos que fallaron al procesarse
+        Map<String, Object> base = Map.of(ProducerConfig.BOOTSTRAP_SERVERS_CONFIG, bootstrap);
+        KafkaTemplate<Object, Object> bytes = new KafkaTemplate<>(
+                new DefaultKafkaProducerFactory<>(base, new ByteArraySerializer(), new ByteArraySerializer()));
+        KafkaTemplate<Object, Object> json = new KafkaTemplate<>(
+                new DefaultKafkaProducerFactory<>(base, new StringSerializer(), new JacksonJsonSerializer<>()));
+        // LinkedHashMap: el orden importa (lo mas especifico primero)
+        Map<Class<?>, KafkaOperations<?, ?>> templates = new LinkedHashMap<>();
+        templates.put(byte[].class, bytes);
+        templates.put(Object.class, json);
+        DeadLetterPublishingRecoverer dlt = new DeadLetterPublishingRecoverer(templates);
+
+        DefaultErrorHandler h = new DefaultErrorHandler((record, ex) -> {
+            log.error("Evento enviado a DLT topic={} particion={} offset={} causa={}",
+                    record.topic(), record.partition(), record.offset(), ex.getMessage());
+            dlt.accept(record, ex);
+        }, new FixedBackOff(1000L, 3L));
         h.addNotRetryableExceptions(IllegalArgumentException.class);
         return h;
     }
-}
\ No newline at end of file
+}
